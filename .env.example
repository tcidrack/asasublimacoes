# Copie este arquivo para .env.local e preencha com a URL do seu Web App.
#
# Onde encontrar: no editor do Apps Script, clique em "Implantar" > "Gerenciar
# implantacoes" e copie a "URL do app da Web". Ela termina em /exec.
#
# Confira na implantacao:
#   Executar como .......: Eu
#   Quem pode acessar ...: Qualquer pessoa   <- e nao "Qualquer pessoa com conta Google"
#
# Essa URL e publica por natureza (vai embutida no bundle do front). Quem tiver
# ela consegue criar pedidos, entao ela nao e um segredo -- e so um endpoint.

VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec

# Telefone do dono, so com numeros e DDI, usado no botao de WhatsApp da tela
# de confirmacao. Deixe vazio para esconder o botao.
VITE_WHATSAPP_LOJA=5511999999999

# PIX exibido na tela de confirmacao, para o cliente pagar a entrada de 50%.
#
# A chave vai no codigo "Copia e Cola" exatamente como escrita aqui:
#   celular ......: +5511999999999   (o +55 e obrigatorio)
#   CPF / CNPJ ...: 12345678901      (so numeros)
#   email ........: loja@exemplo.com
#   aleatoria ....: a chave completa
#
# Nome e cidade sao campos obrigatorios do padrao e aparecem no app do cliente
# na hora de confirmar. Use MAIUSCULAS SEM ACENTO (max 25 e 15 caracteres).
#
# Sem VITE_PIX_CHAVE, o bloco de pagamento simplesmente nao aparece.
VITE_PIX_CHAVE=
VITE_PIX_NOME=NOME DA LOJA
VITE_PIX_CIDADE=SAO PAULO
